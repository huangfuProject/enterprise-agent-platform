  "components": {
    "schemas": {
      "AgentResult": {
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/Summary"
          },
          "specialist": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Summary"
              },
              {
                "type": "null"
              }
            ]
          },
          "specialist_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Specialist Error"
          },
          "answer": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Answer"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "summary",
          "specialist",
          "answer"
        ],
        "title": "AgentResult"
      },
      "ExecutionEvent": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "v1",
            "title": "Contract Version",
            "default": "v1"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "trace_id": {
            "type": "string",
            "title": "Trace Id"
          },
          "sequence": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Sequence"
          },
          "event_type": {
            "type": "string",
            "enum": [
              "execution_started",
              "agent_started",
              "tool_started",
              "tool_completed",
              "agent_completed",
              "execution_completed",
              "execution_failed",
              "execution_cancelled"
            ],
            "title": "Event Type"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "title": "Timestamp"
          },
          "agent": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Agent"
          },
          "tool": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "execution_id",
          "trace_id",
          "sequence",
          "event_type",
          "timestamp"
        ],
        "title": "ExecutionEvent"
      },
      "ExecutionStatus": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "v1",
            "title": "Contract Version",
            "default": "v1"
          },
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "execution_id": {
            "type": "string",
            "title": "Execution Id"
          },
          "checkpoint_thread_id": {
            "type": "string",
            "title": "Checkpoint Thread Id"
          },
          "status": {
            "$ref": "#/components/schemas/Status"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Started At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "error_message": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Message"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/AgentResult"
              },
              {
                "type": "null"
              }
            ]
          },
          "checkpoint_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Checkpoint Id"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "execution_id",
          "checkpoint_thread_id",
          "status",
          "updated_at"
        ],
        "title": "ExecutionStatus"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Limits": {
        "properties": {
          "max_steps": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Max Steps",
            "default": 20
          },
          "timeout_seconds": {
            "type": "integer",
            "maximum": 300.0,
            "minimum": 1.0,
            "title": "Timeout Seconds",
            "default": 120
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Limits"
      },
      "Status": {
        "type": "string",
        "enum": [
          "ACCEPTED",
          "RUNNING",
          "SUCCEEDED",
          "FAILED",
          "CANCELLED"
        ],
        "title": "Status"
      },
      "Summary": {
        "properties": {
          "count": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Count"
          },
          "total": {
            "type": "number",
            "title": "Total"
          },
          "mean": {
            "type": "number",
            "title": "Mean"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "count",
          "total",
          "mean"
        ],
        "title": "Summary"
      },
      "TaskExecutionRequest": {
        "properties": {
          "contract_version": {
            "type": "string",
            "const": "v1",
            "title": "Contract Version",
            "default": "v1"
          },
          "task_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Task Id"
          },
          "execution_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Execution Id"
          },
          "idempotency_key": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Idempotency Key"
          },
          "trace_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Trace Id"
          },
          "request_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,80}$",
            "title": "Request Id"
          },
          "checkpoint_thread_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,160}$",
            "title": "Checkpoint Thread Id"
          },
          "agent_definition": {
            "type": "string",
            "const": "main-agent",
            "title": "Agent Definition",
            "default": "main-agent"
          },
          "input": {
            "$ref": "#/components/schemas/TaskInput"
          },
          "limits": {
            "$ref": "#/components/schemas/Limits"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "task_id",
          "execution_id",
          "idempotency_key",
          "trace_id",
          "request_id",
          "checkpoint_thread_id",
          "input"
        ],
        "title": "TaskExecutionRequest"
      },
      "TaskInput": {
        "properties": {
          "message": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Message"
          },
          "values": {
            "items": {
              "type": "number"
            },
            "type": "array",
            "maxItems": 100,
            "minItems": 1,
            "title": "Values"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "message"
        ],
        "title": "TaskInput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "TaskView": {
        "type": "object",
        "required": [
          "contract_version",
          "task_id",
          "execution_id",
          "revision",
          "state",
          "run_status",
          "trace_id",
          "checkpoint_thread_id"
        ],
        "properties": {
          "contract_version": {
            "type": "string"
          },
          "task_id": {
            "type": "string"
          },
          "execution_id": {
            "type": "string"
          },
          "idempotency_key": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          },
          "request_id": {
            "type": "string"
          },
          "checkpoint_thread_id": {
            "type": "string"
          },
          "run_status": {
            "type": "string"
          },
          "revision": {
            "const": 1
          },
          "state": {
            "enum": [
              "QUEUED",
              "CLAIMED",
              "RUNNING",
              "CANCEL_REQUESTED",
              "SUCCEEDED",
              "FAILED",
              "CANCELLED"
            ]
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "error_message": {
            "type": [
              "string",
              "null"
            ]
          },
          "checkpoint_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "result": {
            "anyOf": [
              {
                "$ref": "AgentResult.schema.json"
              },
              {
                "type": "null"
              }
            ]
          }
        }
      },
      "Error": {
        "type": "object",
        "required": [
          "code",
          "trace_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "trace_id": {
            "type": "string"
          }
        }
