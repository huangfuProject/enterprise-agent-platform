{
  "$defs": {
    "Limits": {
      "additionalProperties": false,
      "properties": {
        "max_steps": {
          "default": 20,
          "maximum": 100,
          "minimum": 1,
          "title": "Max Steps",
          "type": "integer"
        },
        "timeout_seconds": {
          "default": 120,
          "maximum": 300,
          "minimum": 1,
          "title": "Timeout Seconds",
          "type": "integer"
        }
      },
      "title": "Limits",
      "type": "object"
    },
    "TaskInput": {
      "additionalProperties": false,
      "properties": {
        "message": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "values": {
          "items": {
            "type": "number"
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "message"
      ],
      "title": "TaskInput",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "contract_version": {
      "const": "v1",
      "default": "v1",
      "title": "Contract Version",
      "type": "string"
    },
    "task_id": {
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "title": "Task Id",
      "type": "string"
    },
    "execution_id": {
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "title": "Execution Id",
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Idempotency Key",
      "type": "string"
    },
    "trace_id": {
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "title": "Trace Id",
      "type": "string"
    },
    "request_id": {
      "pattern": "^[A-Za-z0-9_-]{1,80}$",
      "title": "Request Id",
      "type": "string"
    },
    "checkpoint_thread_id": {
      "pattern": "^[A-Za-z0-9_-]{1,160}$",
      "title": "Checkpoint Thread Id",
      "type": "string"
    },
    "agent_definition": {
      "const": "main-agent",
      "default": "main-agent",
      "title": "Agent Definition",
      "type": "string"
    },
    "input": {
      "$ref": "#/$defs/TaskInput"
    },
    "limits": {
      "$ref": "#/$defs/Limits"
    }
  },
  "required": [
    "task_id",
    "execution_id",
    "idempotency_key",
    "trace_id",
    "request_id",
    "checkpoint_thread_id",
    "input"
  ],
  "title": "TaskExecutionRequest",
  "type": "object"
}
