# 应用镜像标签与三个 docker save 归档一致
JANGZANG_IMAGE_TAG=0.1.0

# 仅发布到宿主机回环地址。改端口时同步调整宿主机 Nginx 配置。
FRONTEND_PORT=18080
BACKEND_PORT=18081

# 三容器方案使用已有服务的可达地址。五容器方案由 Compose 设置服务名和端口。
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
POSTGRES_DB=eap_p0
POSTGRES_USER=eap_p0
POSTGRES_PASSWORD=replace-with-postgres-password
REDIS_ADDRESS=redis://host.docker.internal:6379
REDIS_PASSWORD=replace-with-redis-password
REDIS_DATABASE=0

# P0 默认使用 Fake 模型。接入真实模型时填写对应地址、名称与密钥。
MODEL_PROVIDER=fake
MODEL_BASE_URL=
MODEL_NAME=p0-deterministic
MODEL_API_KEY=
MODEL_TIMEOUT_SECONDS=30
