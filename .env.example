# Copy to .env. Set a disposable development password; never use in production.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=eap_p0
POSTGRES_USER=eap_p0
POSTGRES_PASSWORD=replace-with-local-development-password
POSTGRES_IMAGE=postgres:17.6-alpine
# Redis coordinates short task mutations; Java also retains database version/fence checks.
REDIS_ADDRESS=redis://127.0.0.1:56379
REDIS_PORT=56379
REDIS_DATABASE=0
REDIS_PASSWORD=replace-with-local-redis-password
REDIS_IMAGE=redis:7.4.2-alpine
LOCK_WAIT_MS=1000
LOCK_WATCHDOG_TIMEOUT_MS=30000
# Optional: identical namespace for all Java instances using the same task database.
# LOCK_KEY_PREFIX=enterprise-agent:eap_p0:lock:
API_PORT=8080
RUNTIME_URL=http://127.0.0.1:8000
MODEL_PROVIDER=fake
MODEL_NAME=p0-deterministic
MODEL_TIMEOUT_SECONDS=30
# For optional live-model test only:
# MODEL_PROVIDER=openai-compatible
# MODEL_NAME=your-model
# MODEL_BASE_URL=http://127.0.0.1:9000/v1
# MODEL_API_KEY_ENV=MODEL_API_KEY
# MODEL_API_KEY=provide-locally
# RUN_LIVE_MODEL=true
